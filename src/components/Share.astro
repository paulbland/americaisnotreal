---
interface Props {
  url: string;
  text: string;
}
const { url, text } = Astro.props;
const e = encodeURIComponent;
const links = [
  { label: "X", href: `https://x.com/intent/post?text=${e(text)}&url=${e(url)}` },
  { label: "Bluesky", href: `https://bsky.app/intent/compose?text=${e(`${text} ${url}`)}` },
  { label: "Threads", href: `https://www.threads.net/intent/post?text=${e(`${text} ${url}`)}` },
  { label: "Reddit", href: `https://www.reddit.com/submit?url=${e(url)}&title=${e(text)}` },
  { label: "Facebook", href: `https://www.facebook.com/sharer/sharer.php?u=${e(url)}` },
  { label: "Email", href: `mailto:?subject=${e(text)}&body=${e(url)}` },
];
---

<ul class="share" data-share data-url={url} data-text={text} aria-label="Share">
  <li hidden data-native>
    <button type="button">Share…</button>
  </li>
  <li hidden data-copy>
    <button type="button">Copy link</button>
  </li>
  {links.map((l) => (
    <li>
      <a
        href={l.href}
        target="_blank"
        rel="noopener noreferrer"
        class={`plausible-event-name=Share plausible-event-network=${l.label}`}
      >
        {l.label}
      </a>
    </li>
  ))}
</ul>

<script>
  type Plausible = (event: string, options?: { props: Record<string, string> }) => void;
  const track = (network: string) =>
    (window as unknown as { plausible?: Plausible }).plausible?.("Share", { props: { network } });

  for (const list of document.querySelectorAll<HTMLElement>("[data-share]")) {
    const { url = "", text = "" } = list.dataset;
    const native = list.querySelector<HTMLElement>("[data-native]")!;
    const copy = list.querySelector<HTMLElement>("[data-copy]")!;
    if (typeof navigator.share === "function") {
      native.hidden = false;
      native.querySelector("button")!.addEventListener("click", () => {
        track("Native");
        navigator.share({ title: text, text, url }).catch(() => {});
      });
    }
    if (navigator.clipboard) {
      copy.hidden = false;
      const button = copy.querySelector("button")!;
      button.addEventListener("click", async () => {
        track("Copy link");
        await navigator.clipboard.writeText(url);
        button.textContent = "Copied";
        setTimeout(() => (button.textContent = "Copy link"), 2000);
      });
    }
  }
</script>
