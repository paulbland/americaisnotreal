---
import Base from "../layouts/Base.astro";
import StoryList from "../components/StoryList.astro";
import { asOf, days } from "../lib/data.ts";
import { plural } from "../lib/format.ts";
import { breadcrumbLd } from "../lib/seo.ts";
import { SITE } from "../lib/site.ts";
import { onSide } from "../lib/stats.ts";

const stories = onSide(days, "genius");
---

<Base
  title={`Genius · ${SITE.name}`}
  description="Every genius story so far: what people in the United States are capable of, one a day, each with its sources."
  path="/genius"
  ogImage="/og/genius.png"
  ogImageAlt="Genius"
  modified={asOf}
  jsonLd={[breadcrumbLd([{ name: "Genius", path: "/genius" }])]}
>
  <div class="day-head">
    <h1>Genius</h1>
    <p class="tagline">
      {plural(stories.length, "story", "stories")} · <a href="/facepalm">see the other side</a>
    </p>
  </div>
  {stories.length ? <StoryList stories={stories} /> : <p class="empty">Nothing yet.</p>}
</Base>
