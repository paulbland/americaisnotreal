---
import "@fontsource-variable/fraunces/opsz.css";
import fraunces from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";
import SpeedInsights from "@vercel/speed-insights/astro";
import "../styles/global.css";
import { SITE } from "../lib/site.ts";

interface Props {
  title: string;
  description: string;
  /** Path portion of the canonical URL, e.g. "/archive" */
  path: string;
  /** Path to a 1200×630 PNG, e.g. "/og/home.png" */
  ogImage: string;
  ogImageAlt: string;
  ogType?: "website" | "article";
  jsonLd?: object[];
  published?: string;
  modified?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  ogImage,
  ogImageAlt,
  ogType = "website",
  jsonLd = [],
  published,
  modified,
  noindex = false,
} = Astro.props;
const canonical = new URL(path, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;
const nav = [
  { href: "/archive", label: "Archive" },
  { href: "/states", label: "States" },
  { href: "/methodology", label: "Methodology" },
  { href: "/about", label: "About" },
];
const plausibleSrc = "https://plausible.io/js/script.outbound-links.tagged-events.js";
const plausibleQueue =
  "window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)}";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        noindex
          ? "noindex, follow"
          : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      }
    />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f5f2eb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121110" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/feed.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {jsonLd.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    {import.meta.env.PROD && (
      <>
        <script is:inline defer data-domain={SITE.domain} src={plausibleSrc} />
        <script is:inline set:html={plausibleQueue} />
      </>
    )}
    <SpeedInsights />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header wrap">
      <a class="wordmark" href="/">
        {SITE.name}
      </a>
      <nav class="site-nav" aria-label="Site">
        {nav.map((item) => (
          <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="More" class="sans">
          <ul>
            <li>
              <a href="/genius">All genius</a>
            </li>
            <li>
              <a href="/facepalm">All facepalm</a>
            </li>
            <li>
              <a href="/categories">Categories</a>
            </li>
            <li>
              <a href="/states">States</a>
            </li>
            <li>
              <a href="/log">Scan log</a>
            </li>
            <li>
              <a href="/feed.xml">RSS</a>
            </li>
            <li>
              <a href="/llms.txt">llms.txt</a>
            </li>
          </ul>
        </nav>
        <p class="meta">
          {SITE.tagline} Every story is reported by at least two accepted news publishers and linked
          to them. We write our own headlines and summaries and never editorialise. Spotted an
          error? <a href={`${SITE.repoUrl}/issues`}>Open an issue</a>; corrections are logged on the
          day's page.
        </p>
        <p class="meta">
          An independent, automated publication. Not affiliated with any news organisation. Text
          licensed <a href={SITE.license.url}>{SITE.license.name}</a>; the linked articles belong to
          their publishers.
        </p>
      </div>
    </footer>
  </body>
</html>
